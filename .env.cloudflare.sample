# 必須: 44文字以上のシークレットキー（openssl rand -hex 32 で生成可能）
SECRET_KEY=

# データベース設定
POSTGRES_USER=hollo
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=hollo

# Cloudflare Tunnel トークン
# Cloudflare Zero Trust (Networks > Tunnels) で作成したトンネルのトークンを指定
CLOUDFLARE_TUNNEL_TOKEN=

# Cloudflare R2 (S3互換ストレージ) 設定
CLOUDFLARE_ACCOUNT_ID=
R2_BUCKET=hollo
# R2バケットの公開URL（カスタムドメイン、または r2.dev のパブリックURL。末尾にスラッシュが必要）
# 例: https://media.yourdomain.com/ または https://pub-xxxxxxxx.r2.dev/
R2_PUBLIC_URL=https://media.yourdomain.com/
# Cloudflare R2 の API トークンから取得
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ログレベル (debug / info / warning / error)
LOG_LEVEL=info
